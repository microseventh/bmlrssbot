# Create a bot with @BotFather and keep this token secret.
TELEGRAM_BOT_TOKEN=
# Use @channelusername or a numeric chat id such as -1001234567890.
TELEGRAM_CHAT_ID=
# Comma-separated RSS or Atom feed URLs.
RSS_FEEDS=https://example.com/feed.xml
POLL_INTERVAL_SECONDS=300
STATE_FILE=/data/state.json
MAX_ITEMS_PER_FEED=20
# Set true to render and log posts without calling Telegram.
DRY_RUN=false
